REM @app-name: Bounce
10 REM A moving ball in 80x80 graphics mode, with sound on impact.
20 GR 80
30 LET X = 10
40 LET Y = 20
50 LET DX = 1
60 LET DY = 2
70 COLOR 7, 255, 255, 255
80 COLOR 8, 255, 100, 100
90 FOR T = 1 TO 300
100 CLS 0
110 FCIRCLE X, Y, 3, 8
120 SOUND 880 + X * 4, 15
130 LET X = X + DX
140 LET Y = Y + DY
150 IF X < 4 THEN LET DX = 1
160 IF X > 76 THEN LET DX = -1
170 IF Y < 4 THEN LET DY = 1
180 IF Y > 76 THEN LET DY = -1
190 WAIT 20
200 NEXT T
210 TEXT
220 PRINT "BOUNCE DONE"
230 END
