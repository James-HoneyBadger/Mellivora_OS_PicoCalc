REM @app-name: FizzBuzz
10 REM Classic FizzBuzz, 1 to 30.
20 FOR N = 1 TO 30
30 LET R3 = N - (N / 3) * 3
40 LET R5 = N - (N / 5) * 5
50 IF R3 = 0 THEN GOTO 200
60 IF R5 = 0 THEN GOTO 300
70 PRINT N
80 GOTO 400
200 LET R5 = N - (N / 5) * 5
210 IF R5 = 0 THEN PRINT "FIZZBUZZ" ELSE PRINT "FIZZ"
220 GOTO 400
300 PRINT "BUZZ"
400 NEXT N
410 END
